# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres connection string. Omit entirely to fall back to a local SQLite
# file (cookify.db) for zero-config local dev.
DATABASE_URL=

# Signs login session tokens (JWT). Required for sessions to survive a
# server restart — without it, a random one is generated per process start
# and everyone gets logged out on every restart. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Outbound email (login/signup/password-reset OTP codes, comment/rating/
# subscription notifications, ban warnings). Omit entirely and emails are
# just printed to the console instead of sent — fine for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to 1 to have this backend also serve the built React app (frontend-react/dist)
# from the same origin/port — the production single-process setup. Leave
# unset for local dev, where the Vite dev server serves the frontend instead.
SERVE_FRONTEND=
